# ===== LLM API配置（推荐：智谱，永久免费）=====
# 智谱开放平台注册即得（无需信用卡）：https://open.bigmodel.cn/usercenter/apikeys
# 免费模型：glm-4.6v-flash（视觉）/ glm-4.7-flash（文本），不消耗额度
ZHIPU_API_KEY=your_zhipu_api_key_here

# ===== 备选：阿里云百炼（付费，按量计费约2-6元/批）=====
# https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# ===== 可选：火山引擎（Doubao 1.5 Pro，如果想进一步多模型去相关）=====
# VOLC_API_KEY=your_volc_api_key_here
# VOLC_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3

# ===== 模型配置 =====
# 视觉理解主力：Qwen-VL系列 / 或 Doubao多模态
FEATURE_EXTRACTION_MODELS=qwen-vl-plus

# 人设扮演模型（多模型混合去相关）
PERSONA_MODELS=qwen-max,deepseek-v3

# ===== 速率控制 =====
# 百炼免费层QPM≈60，建议留余量
QPM_LIMIT=45
# 单轮最大并发人设数（免费层安全值）
MAX_CONCURRENT_PERSONAS=8
# 指数退避重试次数
MAX_RETRIES=3

# ===== 数据路径 =====
# 款式数据（Excel）
STYLES_XLSX=data/styles.xlsx
# 历史销量数据（回测用）
SALES_XLSX=data/sales.xlsx
# 款式图片目录
IMAGES_DIR=data/images
# 报告输出目录
OUTPUT_DIR=output
